+
+// Simple identifier aliases must retain the source relationship; otherwise a
+// common two-step assignment silently downgrades a real tainted sink to review.
+const aliasedCommand = `const input = req.query.command;
+const command = input;
+os.popen(command)`;
+const aliasedResult = analyzeSourceCodeContextAware(aliasedCommand, 'src/network_tool.py');
+const aliasedFinding = aliasedResult.findings.find(finding => finding.cwe.startsWith('CWE-78'));
+assert.ok(aliasedFinding, 'command sink should be detected after a simple alias assignment');
+assert.equal(aliasedFinding?.verificationStatus, 'LIKELY', 'a direct request source preserved through a simple alias should be marked likely, not confirmed');
+assert.equal(aliasedFinding?.confidence, 'HIGH');
+
+// Reassignment to a non-source value must break the simple alias chain.
+const reassignedCommand = `const input = req.query.command;
+let command = input;
+command = 'ping localhost';
+os.popen(command)`;
+const reassignedResult = analyzeSourceCodeContextAware(reassignedCommand, 'src/network_tool.py');
+const reassignedFinding = reassignedResult.findings.find(finding => finding.cwe.startsWith('CWE-78'));
+assert.equal(reassignedFinding?.verificationStatus, 'NEEDS_REVIEW', 'reassignment must invalidate the earlier taint alias');
+
